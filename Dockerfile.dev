FROM composer:2.6.5 AS composer

FROM php:8.2.16-fpm-bookworm AS development

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git unzip libicu-dev libzip-dev libpng-dev libjpeg62-turbo-dev \
        libfreetype6-dev wkhtmltopdf fonts-dejavu-core \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" intl pdo_mysql zip gd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer /usr/bin/composer /usr/local/bin/composer
COPY build/php/dev.ini /usr/local/etc/php/conf.d/sembrar-dev.ini
COPY build/php/dev-fpm.conf /usr/local/etc/php-fpm.d/zz-sembrar-dev.conf
COPY build/php/dev-entrypoint.sh /usr/local/bin/sembrar-dev-entrypoint
RUN chmod +x /usr/local/bin/sembrar-dev-entrypoint

WORKDIR /var/www/symfony
ENTRYPOINT ["sembrar-dev-entrypoint"]
CMD ["php-fpm"]
